# Frontend uchun Supabase sozlamalari (qiymatlarni Supabase Project Settings > API dan oling).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Quyidagi qiymatlar brauzer .env fayliga emas, Supabase Edge Function Secrets
# yoki Vercel Environment Variables ga qo'yiladi:
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# GROQ_API_KEY=your-groq-api-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# CRON_SECRET=a-long-random-secret
